# SolSend GATE 0 spikes — copy to spikes/.env (gitignored) and fill in.
# Never paste these values into chat, issues, or commits.

# ── Solana (devnet only; keypairs live in ~/.config/solsend/devnet, never in the repo)
SOLANA_RPC_URL=https://api.devnet.solana.com
# SOLSEND_KEYS_DIR=~/.config/solsend/devnet

# ── Stripe Sandbox (Canada-registered account; sk_test_/rk_test_ only)
STRIPE_SECRET_KEY=
# Leave unset to use the account default; scripts retry with STRIPE_PREVIEW_VERSION.
# STRIPE_API_VERSION=
# STRIPE_PREVIEW_VERSION=2026-10-28.preview

# ── Bridge sandbox (sk-test… key from dashboard.bridge.xyz/app/keys?sandbox=true)
BRIDGE_API_KEY=
# BRIDGE_BASE_URL=https://api.sandbox.bridge.xyz
# Synthetic cardholder fixture (hard rule 6). Default CAN. Change ONLY with team approval.
# BRIDGE_FIXTURE_COUNTRY=CAN
# BRIDGE_FIXTURE_EMAIL=

# ── Lithic sandbox (Tier 2). Sandbox key only (the Lithic spike scripts, not yet written, will refuse api.lithic.com).
LITHIC_API_KEY=
# LITHIC_BASE_URL=https://sandbox.lithic.com

# ── QuickNode (Streams REST API key; endpoint URL contains a token — treat as secret)
QUICKNODE_API_KEY=
# QN_WEBHOOK_PUBLIC_URL=        # auto-discovered from local ngrok if unset
# QN_STREAM_SECURITY_TOKEN=     # generated by g07:stream if unset
# QN_DATASET=programs_with_logs

# ── Privy (App ID is public; app secret is not needed for G0.8)
VITE_PRIVY_APP_ID=
