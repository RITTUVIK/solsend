# SolSend app env (apps/web). Copy to apps/web/.env.local (gitignored) for local dev; on Vercel set these
# as Project Environment Variables. NEVER commit real values. Devnet + Lithic SANDBOX only.

# ── Solana devnet ───────────────────────────────────────────────────────────
SOLANA_RPC_URL=                      # QuickNode devnet HTTPS endpoint (tokenized URL = secret)
# SOLANA_WS_URL=                     # optional; derived from SOLANA_RPC_URL (https→wss) when unset
SETTLEMENT_AUTHORITY_SECRET_KEY=     # JSON byte array of the settlement-authority keypair (server only)
FEE_PAYER_SECRET_KEY=                # JSON byte array of the fee-payer keypair (server only)
DEMO_FAUCET_SECRET_KEY=              # JSON byte array of a wallet holding devnet test USDC for the faucet
FAUCET_AMOUNT_BASE=5000000           # 5 devnet USDC per claim

# ── Lithic SANDBOX (code refuses any host other than sandbox.lithic.com) ──────────
LITHIC_API_KEY=
LITHIC_ASA_SECRET=                   # whsec_… from GET /v1/auth_stream/secret
LITHIC_EVENTS_SECRET=                # whsec_… of the card_transaction.updated event subscription
ASA_BUDGET_MS=4500                   # hard deadline for the ASA reply (Lithic hard limit is 6000)

# ── Privy (embedded wallets) ─────────────────────────────────────────────────
NEXT_PUBLIC_PRIVY_APP_ID=            # public app id; access tokens are verified with Privy's JWKS
PRIVY_APP_ID=                        # same value, server side

# ── Supabase (free tier; server-only — never NEXT_PUBLIC_; the browser never talks to Supabase) ─────
SUPABASE_URL=                        # https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=                 # sb_secret_… (Settings → API Keys → secret key "solsend-server")
# SUPABASE_SERVICE_ROLE_KEY=         # legacy JWT fallback only; prefer SUPABASE_SECRET_KEY
# SUPABASE_DB_URL=                   # LOCAL ONLY (spikes/.env) for applying migrations; never on Vercel

# ── QuickNode Streams webhook ───────────────────────────────────────────────
QN_STREAM_SECURITY_TOKEN=            # stream security token (HMAC key for x-qn-signature)
# QUICKNODE_API_KEY=                 # ops scripts only (stream create/pause); not needed on Vercel

# ── Ops ─────────────────────────────────────────────────────────────────────
RECONCILE_CRON_SECRET=               # Bearer token for POST /api/reconcile (GitHub Actions cron)
ADMIN_API_TOKEN=                     # Bearer token for /api/admin/* (issuer-outage demo toggle)
DEMO_MERCHANT_ENABLED=1              # sandbox Demo Merchant checkout (0 disables the route)
DEMO_MERCHANT_MAX_CENTS=5000
